{
  "manifestVersion": 2,
  "id": "sp-tasks",
  "name": "任务台",
  "version": "0.11.4",
  "description": "把 Super Productivity 接进对话：管理任务、排期、工时、重复规则、笔记和习惯；内置扩展管理项目、标签、结构、计数器、工作上下文、链接附件、应用内快捷键、界面命令和常用偏好。",
  "entry": "index.js",
  "icon": "assets/icon.svg",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/resources.read",
    "app/resources.write",
    "app/hooks.agent-pre-step",
    "app/runtime.execute",
    "app/runtime.native",
    "app/runtime.network",
    "app/ui.clipboard-write",
    "app/ui.open-external"
  ],
  "network": {
    "allowedHosts": ["127.0.0.1", "localhost"],
    "allowLocalhost": true,
    "methods": ["GET", "POST", "PATCH", "PUT", "DELETE"],
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 8388608
  },
  "contributes": {
    "settings": {
      "title": "任务台",
      "ui": {
        "route": "/settings.html"
      },
      "schema": {
        "type": "object",
        "properties": {
          "baseUrl": {
            "type": "string",
            "title": "Super Productivity 地址",
            "description": "本机 SP 的本地 REST API 地址，默认 http://127.0.0.1:3876。",
            "default": "http://127.0.0.1:3876"
          },
          "accessToken": {
            "type": "string",
            "title": "访问令牌（通常留空）",
            "description": "留空即可：应用会自动从 SP 的数据目录读出 token。只有自动读取失败、或你想换一个 token 时才手填。",
            "sensitive": true,
            "default": ""
          },
          "defaultProjectId": {
            "type": "string",
            "title": "默认项目 ID",
            "description": "新建任务未指定项目时落到这里。留空则进 SP 收件箱。",
            "default": ""
          },
          "followDesktopTheme": {
            "type": "boolean",
            "title": "桌面卡片跟随 Hana 主题",
            "description": "让本机的「SP 桌面卡片」跟着 Hana 当前主题换皮肤。只对装了桌面卡片的电脑有效。",
            "default": false
          }
        }
      }
    }
  },
  "minAppVersion": "1.5.7-beta"
}
